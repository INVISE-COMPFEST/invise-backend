# Application
APP_ENV=development
APP_PORT=8080

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=backend
DB_SSL_MODE=disable
DB_PATH=public

# JWT
JWT_SECRET=your-256-bit-secret-key-change-in-production
JWT_EXPIRY_MINUTES=60

# OTP
OTP_TTL_MINUTES=5

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_USE_SSL=false
MINIO_BUCKET=backend
MINIO_PUBLIC_URL=

# Seeder
SEEDER_EMAIL=admin@example.com
SEEDER_PASSWORD=adminpassword

# Log
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_PATH=./logs/app.log

# Valkey / Redis
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_PASSWORD=
VALKEY_DB=0

# AI Service (invise-ai-)
AI_SERVICE_URL=http://localhost:5000
AI_SERVICE_TIMEOUT_SECONDS=60
